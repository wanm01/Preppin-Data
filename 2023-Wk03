// Preppin' Data Challenge Link: https://preppindata.blogspot.com/2023/01/2023-week-3-targets-for-dsb.html

WITH CTE AS (
SELECT CASE ONLINE_OR_IN_PERSON
        WHEN 1 THEN 'Online'
        WHEN 2 THEN 'In-Person'
        END AS online_or_in_person,
        QUARTER(DATE(transaction_date, 'dd/MM/yyyy hh24:mi:ss')) as transaction_quarter,
        SUM(value) AS value
    FROM PD2023_WK01
WHERE transaction_code LIKE 'DSB%'
GROUP BY online_or_in_person, transaction_quarter
)

SELECT t.online_or_in_person,
    REPLACE(quarter, 'Q') AS short_quarter,
    value,
    target,
    (value - variance_to_target) AS variance_to_target
FROM pd2023_wk03_targets AS t
UNPIVOT(target FOR quarter IN (Q1,Q2,Q3,Q4))
INNER JOIN CTE ON transaction_quarter = short_quarter AND t.online_or_in_person = CTE.online_or_in_person
;
