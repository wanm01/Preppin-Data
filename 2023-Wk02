// Preppin' Data Challenge Link: https://preppindata.blogspot.com/2023/01/2023-week-2-international-bank-account.html

SELECT TRANSACTION_ID,
    CONCAT('GB', check_digits, swift_code, REPLACE(sort_code, '-'), account_number) AS IBAN
FROM PD2023_WK02_TRANSACTIONS AS trans
INNER JOIN PD2023_WK02_SWIFT_CODES AS swift_codes ON swift_codes.bank = trans.bank;
